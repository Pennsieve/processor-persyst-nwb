# Local run configuration (loaded by docker-compose).
#
# The processor takes its input from the single *.lay file in INPUT_DIR and
# writes one NWB file into OUTPUT_DIR; these mirror the volume mounts in
# docker-compose.yml. On the Pennsieve platform the task runner supplies both.
INPUT_DIR=/data/input
OUTPUT_DIR=/data/output

# Filename for the output NWB file. Defaults to <lay stem>.nwb when unset. Must
# be a bare filename. A path writes the output outside OUTPUT_DIR.
# OUTPUT_FILENAME=

# Persyst records TestDate/TestTime as bare wall-clock with no timezone. This
# supplies the missing context. A NeuroPace FILETIME, when present, is already
# UTC and takes precedence over these fields.
PERSYST_TIMEZONE=UTC

# Byte budget for one HDF5 chunk, and the gzip level (0 disables compression).
CHUNK_TARGET_BYTES=4194304
COMPRESSION_LEVEL=4

# Persyst labels channels "Fp1-Ref"; enable to publish them as "Fp1".
STRIP_REF_SUFFIX=false

# Write [Comments] annotations as a TimeIntervals table.
WRITE_COMMENTS=true

# Write the Subject block that comes from [Patient]. That block holds the patient
# ID and the date of birth. A date of birth is a HIPAA Safe Harbor identifier, so
# set this variable to false when the output of the workflow leaves the PHI
# boundary.
WRITE_SUBJECT_METADATA=true
